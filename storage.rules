rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isCreator() {
      return signedIn() && request.auth.token.email == "cosmiceternal9481@gmail.com";
    }

    function isAllowedImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /profilePictures/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isAllowedImage();
      allow delete: if isOwner(userId) || isCreator();
    }

    match /payment-screenshots/{userId}/{fileName} {
      allow read: if isOwner(userId) || isCreator();
      allow create: if isOwner(userId) && isAllowedImage();
      allow update: if false;
      allow delete: if isOwner(userId) || isCreator();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
